# Copie este arquivo para .env.local e preencha.

# Banco PostgreSQL. Com o docker-compose deste projeto:
DATABASE_URL=postgres://provador:provador@localhost:5432/provador

# Prova com IA (opcional): chave do Google AI Studio (https://aistudio.google.com/apikey).
# Sem ela o app funciona normalmente, só o botão "Provar com IA" avisa que falta configurar.
GEMINI_API_KEY=
# Modelo de imagem usado na prova (padrão: gemini-2.5-flash-image).
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# O app é pessoal: só a primeira conta pode ser criada. Mude para true para liberar mais cadastros.
# ALLOW_SIGNUP=false
