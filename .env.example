# Copie este arquivo para .env.local e preencha.

# Banco PostgreSQL. Com o docker-compose deste projeto:
DATABASE_URL=postgres://provador:provador@localhost:5432/provador

# Manequim realista por IA (opcional): Cloudflare Workers AI, plano grátis com cota diária.
# CF_ACCOUNT_ID = ID da conta (aparece no painel da Cloudflare)
# CF_API_TOKEN  = token com permissão "Workers AI" (My Profile > API Tokens > modelo "Workers AI")
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Modelos tentados em ordem (o segundo entra quando a cota do primeiro acaba):
# CF_IMAGE_MODELS=@cf/black-forest-labs/flux-2-klein-9b,@cf/black-forest-labs/flux-2-klein-4b

# O app é pessoal: só a primeira conta pode ser criada. Mude para true para liberar mais cadastros.
# ALLOW_SIGNUP=false
